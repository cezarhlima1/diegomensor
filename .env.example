# Copie este arquivo para .env.local e preencha com os valores reais.

# --- Supabase (Dashboard > Settings > API) ---

# URL do projeto Supabase (pública — vai para o bundle do cliente).
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública) — toda leitura com ela passa pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role — SECRETA, ignora RLS. Somente server-side
# (sem prefixo NEXT_PUBLIC_). Nunca commitar o valor real.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL exclusivo do CRM (somente servidor; nunca usar NEXT_PUBLIC_)
CRM_DATABASE_URL=
CRM_ALLOWED_EMAIL=susanesamt@gmail.com

# --- Leads ---

# URL do Web App do Google Apps Script (Implantar > App da Web),
# usada por /api/lead para gravar leads na planilha.
SHEETS_WEBHOOK_URL=

# URL do Web App do Apps Script vinculado à planilha da pesquisa DESTRAVE.
# O código para publicar está em scripts/pesquisa-destrave.gs.
DESTRAVE_SHEETS_WEBHOOK_URL=

# Webhook opcional exclusivo para as aplicações da mentoria. Se ficar vazio,
# o formulário usa SHEETS_WEBHOOK_URL como destino.
MENTORIA_SHEETS_WEBHOOK_URL=

# --- Meta (Facebook) ---

# Access token da Conversions API — SECRETO, somente server-side.
# Gerar em: Events Manager > Configurações do pixel > Conversions API
# > Gerar token de acesso. Sem ele, /api/ev vira no-op e apenas o
# pixel do browser rastreia (sujeito a adblockers).
META_CAPI_ACCESS_TOKEN=
DIAGNOSTICO_MENTORIA_SHEETS_WEBHOOK_URL=

# --- Planilha -> CRM ---

# Segredo compartilhado com o Apps Script da planilha "Automações de
# cadastro ISCAS" (scripts/planilha-iscas-para-crm.gs). O script envia esse
# valor no header Authorization: Bearer <segredo> ao chamar
# /api/crm/sheets-sync a cada linha nova/editada.
SHEETS_TO_CRM_SECRET=
